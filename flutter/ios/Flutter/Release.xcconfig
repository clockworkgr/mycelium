#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"

MYCELIUM_FFI_DIR=$(SRCROOT)/MyceliumFFI/Frameworks
LIBRARY_SEARCH_PATHS=$(inherited) $(MYCELIUM_FFI_DIR) ${PODS_CONFIGURATION_BUILD_DIR}
HEADER_SEARCH_PATHS=$(inherited) $(MYCELIUM_FFI_DIR)/include
OTHER_LDFLAGS=$(inherited) -force_load $(MYCELIUM_FFI_DIR)/libmycelium_ffi.a -lc++ -lresolv -framework Security -framework SystemConfiguration -u _mycelium_last_error -u _mycelium_clear_error -u _mycelium_node_new -u _mycelium_node_start -u _mycelium_node_stop -u _mycelium_node_id -u _mycelium_node_free -u _mycelium_node_get_existing -u _mycelium_send_message -u _mycelium_get_messages -u _mycelium_contact_count -u _mycelium_get_contacts -u _mycelium_send_group_message -u _mycelium_network_status -u _mycelium_add_vouch -u _mycelium_trust_score -u _mycelium_verify_session -u _mycelium_safety_number -u _mycelium_get_conversations -u _mycelium_update_battery -u _mycelium_create_group -u _mycelium_add_group_member -u _mycelium_set_message_callback -u _mycelium_register_ble_transport -u _mycelium_register_wifi_direct_transport -u _mycelium_ble_on_peer_discovered -u _mycelium_ble_on_peer_lost -u _mycelium_ble_on_data_received -u _mycelium_wifi_on_peer_connected -u _mycelium_wifi_on_peer_disconnected -u _mycelium_wifi_on_data_received -u _mycelium_ble_dequeue_send -u _mycelium_wifi_dequeue_send -u _mycelium_ble_set_send_callback -u _mycelium_wifi_set_send_callback -u _mycelium_delete_conversation -u _mycelium_mark_read -u _mycelium_unread_count -u _mycelium_total_unread_count -u _mycelium_set_display_name -u _mycelium_get_display_name -u _mycelium_group_member_count -u _mycelium_get_group_members -u _mycelium_remove_group_member -u _mycelium_set_node_display_name -u _mycelium_register_lora_transport -u _mycelium_register_lora_transport_configured -u _mycelium_lora_on_peer_discovered -u _mycelium_lora_on_peer_lost -u _mycelium_lora_on_data_received -u _mycelium_lora_dequeue_send -u _mycelium_lora_report_tx_success -u _mycelium_lora_report_tx_failure -u _mycelium_register_bt_classic_transport -u _mycelium_bt_classic_on_peer_connected -u _mycelium_bt_classic_on_peer_disconnected -u _mycelium_bt_classic_on_data_received -u _mycelium_bt_classic_dequeue_send -u _mycelium_register