#!/bin/sh /etc/rc.common
# Mycelium mesh daemon init script

START=99
STOP=10

USE_PROCD=1
PROG=/usr/bin/mycelium-node

start_service() {
    local data_dir display_name node_type

    config_load mycelium
    config_get data_dir main data_dir '/tmp/mycelium'
    config_get display_name main display_name 'OpenWRT-Supernode'
    config_get node_type main node_type 'supernode'

    mkdir -p "$data_dir"

    # Generate config TOML from UCI
    cat > /tmp/mycelium.toml <<EOF
data_dir = "$data_dir"
display_name = "$display_name"
node_type = "Supernode"
beacon_interval_secs = 10

[transports]
wifi_direct = false
ble = false
lora = false
internet_tunnel = false
mock = true

[dtn]
max_storage_mb = 2048
per_identity_quota_mb = 50
ttl_hours = 72
spray_copies = 8
EOF

    procd_open_instance
    procd_set_param command "$PROG" /tmp/mycelium.toml
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
